---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollReveal from "../components/ScrollReveal.astro";

import LinkIcon from "../components/icons/LinkIcon.astro";

import { Image } from "astro:assets";

interface Props {
    caption: string;
    url?: string;
    banner?: ImageMetadata;
    bannerAlt?: string;
}

const { caption, url = "", banner, bannerAlt } = Astro.props;
---

<BaseLayout title={caption}>
    <div class="flex flex-col mt-8 md:mt-0">
        <p class="scroll-reveal text-4xl md:text-5xl text-center">{caption}</p>

        {
            banner && bannerAlt && (
                <div class="scroll-reveal px-6 md:px-0">
                    <Image
                        src={banner}
                        width="800"
                        alt={bannerAlt}
                        class="md:mt-16 mt-5 mb-5 mx-auto rounded-2xl"
                    />
                </div>
            )
        }

        <section
            class="scroll-reveal mt-4 opacity-75 text-center text-pretty text-lg sm:text-xl leading-relaxed px-4 sm:px-0 mx-auto max-w-prose sm:max-w-2xl"
        >
            <slot name="desc" />
        </section>

        <section class="mx-10 mt-14 md:mx-auto md:max-w-3xl">
            <slot name="article" />
        </section>
        {
            url && (
                <div class="scroll-reveal mx-auto my-14 w-fit">
                    <div class="rounded-md px-3 py-2 bg-primary-dark dark:bg-primary-light text-primary-light dark:text-primary-dark flex items-center space-x-2 md:hover:-translate-y-1 transition ease-in-out duration-200">
                        <a href={url} target="_blank">
                            Visit on GitHub
                        </a>
                        <LinkIcon />
                    </div>
                </div>
            )
        }
        <slot name="footer" />
        <footer
            id="project-footer"
            class="flex flex-wrap items-center justify-between gap-4 w-[min(64rem,calc(100%-3rem))] mt-4 mx-auto pt-4 border-t border-[#8884] text-[0.875rem]"
        >
            <span class="opacity-65">{caption}</span>
            <a
                href="/"
                class="inline-flex items-center gap-4 min-h-11 hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-current focus-visible:outline-offset-4"
                >Back to projects <span aria-hidden="true">↗</span></a
            >
        </footer>
    </div>
    <ScrollReveal />
</BaseLayout>
