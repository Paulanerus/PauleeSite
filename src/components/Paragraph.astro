---
interface Props {
    headline: string;
}

const { headline } = Astro.props;
---

<div>
    <p class="scroll-reveal text-3xl mb-8">{headline}</p>
    <div class="flex flex-col gap-8 text-lg text-pretty hyphens-auto">
        <slot name="parts">
            <div class="scroll-reveal">
                <slot />
            </div>
        </slot>
    </div>
</div>
